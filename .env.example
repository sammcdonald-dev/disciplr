# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# The following keys below are automatically created and
# added to your environment when you deploy on vercel

# Get your Gemini API Key here for chat and image models: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=****

# # Instructions to create a Vercel Blob Store here: https://vercel.com/docs/storage/vercel-blob
# BLOB_READ_WRITE_TOKEN=****

# Instructions to create a PostgreSQL database here: https://vercel.com/docs/storage/vercel-postgres/quickstart
POSTGRES_URL="postgresql://postgres:postgres@postgres:5432/disciplr"


# Instructions to create a Redis store here:
# https://vercel.com/docs/redis
REDIS_URL="redis://default:password@redis:6379"

DATABASE_URL="postgresql://postgres:postgres@postgres:5432/disciplr"

# Stripe billing keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=STRIPE...
STRIPE_WEBHOOK_SECRET=

# Public app URL used for Stripe redirect URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Owner bypass key for Stripe payments (set to any string to enable)
# When set, users can bypass payment by setting cookie "owner-key" to this value
OWNER_BYPASS_KEY=